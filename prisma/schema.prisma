generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PurchaseStatus {
  COMPLETED
  REFUNDED
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String
  creditBalance Int            @default(10000)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  purchases     Purchase[]
  refunds       Refund[]
  cosmetics     UserCosmetic[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Cosmetic {
  id            String          @id @default(uuid())
  externalId    String          @unique
  name          String
  description   String?
  type          String
  typeLabel     String
  rarity        String
  rarityLabel   String
  images        Json
  apiAddedAt    DateTime?
  isNew         Boolean         @default(false)
  firstSyncedAt DateTime        @default(now())
  lastSyncedAt  DateTime        @updatedAt
  offerItems    ShopOfferItem[]
  purchaseItems PurchaseItem[]
  owners        UserCosmetic[]

  @@index([name])
  @@index([type])
  @@index([rarity])
  @@index([apiAddedAt])
  @@index([isNew])
}

model ShopOffer {
  id            String          @id @default(uuid())
  externalId    String          @unique
  name          String?
  regularPrice  Int
  finalPrice    Int
  isPromotional Boolean         @default(false)
  section       String?
  imageUrl      String?
  isActive      Boolean         @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  lastSeenAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         ShopOfferItem[]
  purchases     Purchase[]

  @@index([isActive, lastSeenAt])
  @@index([isActive, isPromotional])
  @@index([finalPrice])
}

model ShopOfferItem {
  offerId    String
  cosmeticId String
  position   Int       @default(0)
  offer      ShopOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  cosmetic   Cosmetic  @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@id([offerId, cosmeticId])
  @@index([cosmeticId])
}

model Purchase {
  id          String         @id @default(uuid())
  userId      String
  offerId     String?
  displayName String
  amount      Int
  status      PurchaseStatus @default(COMPLETED)
  purchasedAt DateTime       @default(now())
  refundedAt  DateTime?
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  offer       ShopOffer?     @relation(fields: [offerId], references: [id], onDelete: SetNull)
  items       PurchaseItem[]
  ownedItems  UserCosmetic[]
  refund      Refund?

  @@index([userId, purchasedAt])
  @@index([status])
}

model PurchaseItem {
  purchaseId String
  cosmeticId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  cosmetic   Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Restrict)

  @@id([purchaseId, cosmeticId])
  @@index([cosmeticId])
}

model UserCosmetic {
  userId     String
  cosmeticId String
  purchaseId String
  acquiredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic   Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Restrict)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@id([userId, cosmeticId])
  @@index([purchaseId])
  @@index([userId, acquiredAt])
}

model Refund {
  id         String   @id @default(uuid())
  purchaseId String   @unique
  userId     String
  amount     Int
  createdAt  DateTime @default(now())
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model SyncRun {
  id         String     @id @default(uuid())
  source     String
  status     SyncStatus @default(RUNNING)
  itemCount  Int        @default(0)
  error      String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?

  @@index([source, startedAt])
}
